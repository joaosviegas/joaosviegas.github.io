---
const groups = [
  {
    id: 'experience',
    title: 'Experience',
    rows: [
      {
        role: 'Full Stack Developer',
        org: 'DEI, Department of Computer Science and Engineering · Instituto Superior Técnico',
        dates: 'Nov 2025 · Present',
        location: 'Lisbon · Hybrid',
        logo: '/images/ist_logo_crop.png',
        open: true,
        details: [
          'Research initiation grant at the Department.',
          'I develop internal applications and manage the systems the Department relies on.',
          "I'm building a mobility management platform in Java Spring Boot and Vue, integrating student mobility with the Department's existing apps and the university API.",
          'I also provide technical support to Department staff.',
        ],
        tags: 'Java · Spring Boot · Vue',
      },
      {
        role: 'Founder & Website Designer',
        org: 'Discrete Design',
        dates: 'Jan 2025 · Dec 2025',
        location: 'Remote',
        logo: '/images/discrete_design_logo.jpg',
        details: [
          'I founded and ran a freelance studio building custom Squarespace websites for nonprofits, founders and solo entrepreneurs.',
          'I lead each project end to end: client discovery, information architecture, visual design, content integration and launch.',
          'I managed timelines, client communication and delivery.',
        ],
        link: { label: 'Selected work', href: '#design-web' },
        tags: 'Web Design · Squarespace',
      },
    ],
  },
  {
    id: 'education',
    title: 'Education',
    rows: [
      {
        role: "Master's in Computer Science and Engineering",
        org: 'Instituto Superior Técnico, University of Lisbon',
        dates: 'Sep 2026 · Present',
        logo: '/images/ist_logo_crop.png',
        details: [
          'Expected completion in 2028.',
          'Specialization in Software Engineering, and Enterprise Systems.',
        ],
        link: { label: 'Instituto Superior Técnico', href: 'https://tecnico.ulisboa.pt/', external: true },
      },
      {
        role: "Bachelor's in Computer Science and Engineering",
        org: 'Instituto Superior Técnico, University of Lisbon',
        dates: 'Sep 2023 · Jul 2026',
        logo: '/images/ist_logo_crop.png',
        details: [
          'Final GPA of 16/20.',
          'Relevant coursework in Software Engineering, Systems Analysis and Modelling, and Human-Computer Interaction.',
          'Merit Award in Systems Analysis and Modelling, 2025/2026.',
        ],
        link: { label: 'Instituto Superior Técnico', href: 'https://tecnico.ulisboa.pt/', external: true },
      },
      {
        role: 'Gulbenkian Merit Scholarship',
        org: 'Fundação Calouste Gulbenkian',
        dates: 'Sep 2023 · Present',
        logo: '/images/calouste_gulbenkian_foundation_logo.jpg',
        details: [
          [
            'Merit scholarship awarded by the ',
            { t: 'Calouste Gulbenkian Foundation', href: 'https://gulbenkian.pt/' },
            ' throughout my studies at Técnico',
            '.',
          ],
        ],
      },
    ],
  },
];
---
<section class="timeline" aria-label="Experience and education">
  {groups.map((g) => (
    <div class="group" id={g.id}>
      <h2>{g.title}</h2>
      <div class="rows">
        {g.rows.map((r) => (
          <details class="row" name="timeline" open={r.open}>
            <summary>
              <img src={r.logo} width="44" height="44" alt="" loading="lazy" />
              <span class="row__main">
                <h3>{r.role}</h3>
                <span class="row__org">{r.org}</span>
              </span>
              <span class="mono row__dates">{r.dates}</span>
              <svg class="row__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /><path class="v" d="M12 5v14" /></svg>
            </summary>
            <div class="row__body">
              {r.location && <p class="mono">{r.location}</p>}
              {r.details.map((d) => (
                <p>{Array.isArray(d) ? d.map((x) => typeof x === 'string' ? x : <a class="inline" href={x.href} target="_blank" rel="noopener">{x.t}</a>) : d}</p>
              ))}
              {r.link && (
                <a class="row__link" href={r.link.href} {...(r.link.external ? { target: '_blank', rel: 'noopener' } : {})}>
                  {r.link.label}
                  {r.link.external && <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>}
                </a>
              )}
              {r.tags && <p class="mono row__tags">{r.tags}</p>}
            </div>
          </details>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  :global(:root) { interpolate-size: allow-keywords; }
  .timeline {
    margin: var(--section-gap) var(--gutter) 0; padding-inline: clamp(24px, 5vw, 72px);
    display: grid; gap: clamp(96px, 12vw, 180px);
  }
  .group { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--s5); scroll-margin-top: var(--s8); }
  h2 { font-size: var(--fs-h2); position: sticky; top: calc(var(--nav-h) + var(--s4)); align-self: start; }
  .rows { border-top: 1px solid var(--border); }
  .row { border-bottom: 1px solid var(--border); }
  summary {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; align-items: center; gap: var(--s2) var(--s3);
    padding: var(--s3) 0; cursor: pointer; list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary img { width: 44px; height: 44px; object-fit: cover; border-radius: 50%; background: #fff; border: 1px solid var(--border); }
  .row__main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  h3 { font-size: var(--fs-row); font-weight: var(--fw-medium); letter-spacing: -0.02em; line-height: 1.15; }
  .row__org { color: var(--muted); font-size: 0.9375rem; }
  .row__dates { white-space: nowrap; }
  .row__icon { color: var(--muted); transition: color var(--dur) var(--ease); }
  .row__icon .v { transform-origin: center; transition: transform var(--dur) var(--ease); }
  .row[open] .row__icon { color: var(--accent-ink); }
  .row[open] .row__icon .v { transform: scaleY(0); }
  summary:hover h3 { color: var(--muted); }
  h3 { transition: color var(--dur) var(--ease); }

  .row::details-content { block-size: 0; overflow: clip; transition: block-size var(--dur) var(--ease), content-visibility var(--dur) allow-discrete; }
  .row[open]::details-content { block-size: auto; }
  .row__body { display: grid; gap: var(--s2); max-width: 62ch; padding: 0 0 var(--s4) calc(44px + var(--s3)); }
  .row__body p { margin: 0; color: var(--muted); }
  .row__body p.mono { color: var(--muted); }
  .row__body p:not(.mono) { color: var(--text); }
  .row__link { justify-self: start; text-underline-offset: 5px; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; }
  .row__body a.inline { text-underline-offset: 4px; text-decoration-color: var(--muted); transition: color var(--dur) var(--ease); }
  .row__body a.inline:hover { color: var(--muted); }
  .row__link:hover { color: var(--muted); }

  @media (max-width: 860px) {
    .group { grid-template-columns: minmax(0, 1fr); gap: var(--s4); }
    h2 { position: static; }
    summary { grid-template-columns: auto minmax(0, 1fr) auto; }
    .row__dates { grid-column: 2; grid-row: 2; }
    .row__icon { grid-column: 3; grid-row: 1; }
    .row__body { padding-left: 0; }
  }
</style>
