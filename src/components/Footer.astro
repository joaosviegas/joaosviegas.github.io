---
const links = [
  ['GitHub', 'https://github.com/joaosviegas'],
  ['LinkedIn', 'https://linkedin.com/in/joao-sergio-viegas'],
  ['CV', '/cv.pdf'],
];
---
<footer class="footer" id="contact">
  <div class="footer__top">
    <p class="footer__line">Open to new projects and collaborations.</p>
    <div class="footer__contact">
      <a class="mono footer__email" href="mailto:joao.viegas@rnl.tecnico.ulisboa.pt">joao.viegas@rnl.tecnico.ulisboa.pt</a>
      <ul class="footer__links">
        {links.map(([label, href]) => (
          <li><a href={href} {...(!href.startsWith('mailto:') ? { target: '_blank', rel: 'noopener' } : {})}>{label}</a></li>
        ))}
      </ul>
    </div>
  </div>

