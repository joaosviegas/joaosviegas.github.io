<style>
  .footer {
    margin: var(--gutter); padding: clamp(40px, 6vw, 96px) clamp(24px, 5vw, 72px) var(--s4);
    background: var(--footer-bg); color: var(--footer-text); border-radius: var(--radius-section);
    scroll-margin-top: var(--s2);
  }
  .footer__top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: var(--s5); }
  .footer__line { max-width: 16ch; margin: 0; font-size: var(--fs-h2); font-weight: var(--fw-medium); letter-spacing: var(--track-tight); line-height: 1.05; text-wrap: balance; }
  .footer__contact { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); }
  .footer__email { display: inline-flex; align-items: center; min-height: 44px; color: var(--footer-text); text-underline-offset: 5px; transition: color var(--dur) var(--ease); }
  .footer__links { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); margin: 0; padding: 0; list-style: none; }
  .footer__links a {
    display: inline-flex; align-items: center; min-height: 44px; color: var(--footer-text); font-weight: var(--fw-medium);
    text-decoration: underline; text-underline-offset: 6px; text-decoration-color: rgb(245 245 243 / 0.25);
    transition: color var(--dur) var(--ease), text-decoration-color var(--dur) var(--ease);
  }
  .footer__links a:hover, .footer__email:hover { color: var(--footer-muted); text-decoration-color: currentColor; }
  .footer__mark { display: block; width: 100%; height: auto; margin: clamp(56px, 9vw, 140px) 0 var(--s4); overflow: visible; }
  .footer__copy { margin: 0; color: var(--footer-muted); }
  .footer .mono { color: var(--footer-muted); }
  .footer .footer__email { color: var(--footer-text); }
  @media (max-width: 640px) { .footer__top { align-items: flex-start; } }
</style>
