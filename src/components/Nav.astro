---
const links = [
  ['Experience', '#experience'],
  ['Education', '#education'],
  ['Design', '#design'],
];
---
<header class="nav">
  <nav class="nav__inner" aria-label="Primary">
    <a class="nav__mark" href="#top">joaosviegas</a>
    <ul class="nav__links">
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
    <button class="nav__theme" type="button" aria-label="Switch to light mode" data-theme-toggle>
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a7 7 0 0 0 10.7 10.7z"/></svg>
    </button>
    <a class="nav__contact" href="#contact">Contact</a>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const root = document.documentElement;
  const sync = () => btn.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
  sync();
  btn.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 50; height: var(--nav-h); background: var(--bg); }
  .nav__inner {
    display: flex; align-items: center; gap: var(--s4); height: 100%;
    padding-inline: calc(var(--gutter) + clamp(24px, 5vw, 72px));
  }
  .nav__mark { display: inline-flex; align-items: center; min-height: 44px; margin-right: auto; font-weight: var(--fw-semibold); letter-spacing: var(--track-tight); font-size: 1.125rem; text-decoration: none; }
  .nav__links { display: flex; gap: var(--s4); margin: 0; padding: 0; list-style: none; }
  .nav__links a, .nav__contact {
    display: inline-flex; align-items: center; min-height: 44px; font-size: 0.9375rem; font-weight: var(--fw-medium); text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .nav__links a { color: var(--muted); }
  .nav__links a:hover, .nav__theme:hover { color: var(--accent-ink); }
  .nav__contact:hover { color: var(--muted); }
  .nav__contact { text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--border); }
  .nav__theme {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; cursor: pointer;
    background: none; border: 0; color: var(--muted); transition: color var(--dur) var(--ease);
  }
  :global(:root[data-theme='dark']) .icon-moon, :global(:root[data-theme='light']) .icon-sun { display: none; }
  @media (max-width: 640px) { .nav__links { display: none; } .nav__inner { gap: var(--s2); } }
</style>
